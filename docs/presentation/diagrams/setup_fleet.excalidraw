   "isDeleted": false,
   "boundElements": null,
   "updated": 1791169705274,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Why cap the KV cache? A slice could hold ~1M tokens, so memory would never matter. At 4.5 GiB, 40 documents overflow one\nreplica's cache but fit in two halves: the condition under which smart placement can show anything.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 32,
   "containerId": null,
   "originalText": "Why cap the KV cache? A slice could hold ~1M tokens, so memory would never matter. At 4.5 GiB, 40 documents overflow one\nreplica's cache but fit in two halves: the condition under which smart placement can show anything.",
   "lineHeight": 1.15
  },
