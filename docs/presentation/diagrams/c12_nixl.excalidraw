   "updated": 1791169710170,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "UCX wanted CUDA IPC (GPU to GPU), but the two\nreplicas live in separate HAMi containers:\nno IPC between them \u2192 falls back to TCP\n~206 MB per call at ~92 MB/s",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 66,
   "containerId": "u",
   "originalText": "UCX wanted CUDA IPC (GPU to GPU), but the two\nreplicas live in separate HAMi containers:\nno IPC between them \u2192 falls back to TCP\n~206 MB per call at ~92 MB/s",
   "lineHeight": 1.15
  },
