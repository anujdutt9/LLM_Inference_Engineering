   "isDeleted": false,
   "boundElements": null,
   "updated": 1791172436254,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "v2 \u00b7 prefer the least busy replica with \u2265 80% remembered\nprefix overlap AND a free slot, on either side",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 31,
   "containerId": "v2a",
   "originalText": "v2 \u00b7 prefer the least busy replica with \u2265 80% remembered\nprefix overlap AND a free slot, on either side",
   "lineHeight": 1.15
  },
