   "customData": null,
   "text": "Fixes: let a probe call through now and then \u00b7 decay the rate toward its prior when idle \u00b7\nmeasure prefill with vLLM's own timer instead of dispatch \u2192 first token",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 41,
   "containerId": null,
   "originalText": "Fixes: let a probe call through now and then \u00b7 decay the rate toward its prior when idle \u00b7\nmeasure prefill with vLLM's own timer instead of dispatch \u2192 first token",
   "lineHeight": 1.15
  },
