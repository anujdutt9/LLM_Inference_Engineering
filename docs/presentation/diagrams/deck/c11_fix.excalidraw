  {
   "id": "CkaUrQwJsPqjqaEFPro7P",
   "type": "text",
   "x": 0,
   "y": 320,
   "width": 755.470703125,
   "height": 39.099999999999994,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
