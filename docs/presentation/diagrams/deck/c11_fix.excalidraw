   "roundness": null,
   "seed": 1318292721,
   "version": 1,
   "versionNonce": 0,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791223707995,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Same load, same documents: goodput 4.50 \u2192 6.12 calls/s (+36%), prompt from cache 47% \u2192 66%.\nSo Part 2's small gain was mostly v1's bugs, not just the busy replicas.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 35,
   "containerId": null,
   "originalText": "Same load, same documents: goodput 4.50 \u2192 6.12 calls/s (+36%), prompt from cache 47% \u2192 66%.\nSo Part 2's small gain was mostly v1's bugs, not just the busy replicas.",
   "lineHeight": 1.15
  },
  {
   "id": "W28qggbXs8gYWnBr5HlDF",
   "type": "text",
   "x": 107.412109375,
   "y": 59.125,
   "width": 345.17578125,
   "height": 51.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1072477855,
   "version": 2,
   "versionNonce": 190236369,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791223707995,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "v1 \u00b7 tie-break: both replicas match the prefix?\n\u2192 always replica a. When a was full, fall back to\np2c / load scoring, even if b also matched with room",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 49,
   "containerId": "v1a",
   "originalText": "v1 \u00b7 tie-break: both replicas match the prefix?\n\u2192 always replica a. When a was full, fall back to\np2c / load scoring, even if b also matched with room",
   "lineHeight": 1.15
  },
  {
   "id": "BZgMZXzyEBHmFTj5Nnxei",
   "type": "text",
   "x": 97.403564453125,
   "y": 199.125,
   "width": 365.19287109375,
   "height": 51.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 259689151,
   "version": 2,
   "versionNonce": 592954545,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791223707996,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "v1 \u00b7 memory: 50,000 \u00d7 16-token blocks (~800K tokens)\nfor a cache that holds ~265K tokens \u2192 affinity to\nreplicas that had likely evicted the prefix already",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 49,
   "containerId": "v1b",
   "originalText": "v1 \u00b7 memory: 50,000 \u00d7 16-token blocks (~800K tokens)\nfor a cache that holds ~265K tokens \u2192 affinity to\nreplicas that had likely evicted the prefix already",
   "lineHeight": 1.15
  },
  {
   "id": "NQykNiQgxUdzVrbOuZ7eI",
   "type": "text",
   "x": 730.379638671875,
   "y": 67.75,
   "width": 379.24072265625,
   "height": 34.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
