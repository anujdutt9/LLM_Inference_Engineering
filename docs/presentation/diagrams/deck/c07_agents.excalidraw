  {
   "id": "YAMyG9MKdyAcR7BLf2-4m",
   "type": "text",
   "x": 0,
   "y": 310,
   "width": 957.453125,
   "height": 55.199999999999996,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 896435295,
   "version": 1,
   "versionNonce": 0,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791223713269,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Leads orchestrate; at the peak, 16 subagent calls ran at once: every slot (8 readers + 4 + 4). Two readers share each ~10K-token filing,\nso the gateway keeps each pair on the replica that has it cached: 77% of prompt tokens came from cache.\nServing held up (607 calls, split 300 / 307, no preemption). The limits were the agent harness and the 9B's quality.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 51,
   "containerId": null,
   "originalText": "Leads orchestrate; at the peak, 16 subagent calls ran at once: every slot (8 readers + 4 + 4). Two readers share each ~10K-token filing,\nso the gateway keeps each pair on the replica that has it cached: 77% of prompt tokens came from cache.\nServing held up (607 calls, split 300 / 307, no preemption). The limits were the agent harness and the 9B's quality.",
   "lineHeight": 1.15
  },
