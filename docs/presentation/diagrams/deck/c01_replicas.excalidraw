   "updated": 1791223710596,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Why: each engine's decode step reads ~17 GiB of weights once for its active batch.\nOne engine with 16 calls shares that read across all 16. Two engines repeat it and take turns.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 37,
   "containerId": null,
   "originalText": "Why: each engine's decode step reads ~17 GiB of weights once for its active batch.\nOne engine with 16 calls shares that read across all 16. Two engines repeat it and take turns.",
   "lineHeight": 1.15
  },
