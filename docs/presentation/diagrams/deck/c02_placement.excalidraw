   "link": null,
   "locked": false,
   "customData": null,
   "text": "The gateway does not ask vLLM what is cached: it remembers which prompt prefixes it sent where, and prefers that\nreplica while it has a free slot. Otherwise it places by load.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 32,
   "containerId": null,
   "originalText": "The gateway does not ask vLLM what is cached: it remembers which prompt prefixes it sent where, and prefers that\nreplica while it has a free slot. Otherwise it places by load.",
   "lineHeight": 1.15
  },
