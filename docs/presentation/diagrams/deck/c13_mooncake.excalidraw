   "updated": 1791223709010,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "214.5 MB in 163 ms = 1,319 MB/s\n(14\u00d7 NIXL over TCP on the same box)\ndecode's first token after 0.27 s\nvs 0.37 s to re-read: 25% faster",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 66,
   "containerId": "g",
   "originalText": "214.5 MB in 163 ms = 1,319 MB/s\n(14\u00d7 NIXL over TCP on the same box)\ndecode's first token after 0.27 s\nvs 0.37 s to re-read: 25% faster",
   "lineHeight": 1.15
