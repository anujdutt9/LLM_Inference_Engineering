   "updated": 1791223706989,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Measured (H1): 24 users sustained instead of 16, 1.8\u00d7 the goodput at 24 users (4.02 vs 2.20 calls/s).\nReplicas still matter, for failover and across GPUs, but on one GPU batch first.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 35,
   "containerId": null,
   "originalText": "Measured (H1): 24 users sustained instead of 16, 1.8\u00d7 the goodput at 24 users (4.02 vs 2.20 calls/s).\nReplicas still matter, for failover and across GPUs, but on one GPU batch first.",
   "lineHeight": 1.15
  },
