# Copy to .env (git-ignored) and fill in. Read on the laptop by setup/*.sh and experiments/*.sh
# (they `source` it); nothing else in the project reads environment variables from here.

# Required for the GPU box: user@IP and the SSH key Lambda gave you
LAMBDA=ubuntu@YOUR_LAMBDA_IP
LAMBDA_SSH_KEY=$HOME/.ssh/YOUR_LAMBDA_KEY

# Optional. Grafana's admin password (setup/demo_cluster.sh prints it after installing Grafana): lets the experiment
# scripts add run markers to the dashboards and export them in collect.sh. Without it they are skipped.
GRAFANA_PASSWORD=

# Optional. The overflow provider's API key (Superlinked in the runs). setup/overflow_secret.sh stores it
# on the box as a Kubernetes secret that the gateway pod reads; it never goes into the repo or the config.
# Everything else about overflow lives in the gateway config, not here: `overflow:` in gateway/config.yaml
# (Setup B) and gateway/config-27b-9b.yaml (Setup A): enabled, dry_run, base_url, the target model per
# pool, the call budget and the in-flight cap. Without a key the gate only counts what would have left.
OVERFLOW_API_KEY=
